@model IEnumerable<MPI_Report.Models.DailyMeeting>

@{
    ViewBag.Title = "Daily meetings";
}

<h2>Daily meetings</h2>
<p>@Html.ActionLink("Add meeting", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Signatures</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MeetingDate.ToString("dd-MMM-yy")</td>
                <td>@item.Description</td>
                <td>@item.Signatures</td>
            </tr>
        }
    </tbody>
</table>
