<!DOCTYPE html>
<html ng-app="myApp">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Login") - Inspections Track</title>
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/CSS/login.style.css");
</head>
<body>
    <div class="container">
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/app/app.js"></script>
    <script src="~/Scripts/app/services/accountService.js"></script>
    <script src="~/Scripts/app/controllers/accountController.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
