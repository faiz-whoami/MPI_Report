<!DOCTYPE html>
<html ng-app="myApp">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - Inspections Track</title>

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")

    <link href="~/Content/CSS/dashboard-layout.css" rel="stylesheet" />
    <link href="~/Content/CSS/home.style.css" rel="stylesheet" />
    <link href="~/Content/CSS/inventory.styles.css" rel="stylesheet" />

</head>

<body>

    <div class="app-layout">

        <!-- HEADER -->
        @Html.Partial("_Header")


        <!-- SIDEBAR -->
        @Html.Partial("_Sidebar")


        <!-- MAIN CONTENT -->
        <main class="main-content">

            <div class="content-container">

                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info dashboard-alert">
                        @TempData["Message"]
                    </div>
                }

                @RenderBody()

            </div>

        </main>

    </div>


    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/bootstrap")

    <script src="~/Scripts/angular.min.js"></script>

    <script src="~/Scripts/app/app.js"></script>

    <script src="~/Scripts/app/services/homeService.js"></script>

    @RenderSection("scripts", required: false)

</body>

</html>