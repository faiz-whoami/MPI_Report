@model MPI_Report.Models.InspectionChecklist

@{
    ViewBag.Title = "Add checklist";
}

<h2>Add checklist</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Title)
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Frequency)
        @Html.DropDownListFor(m => m.Frequency, new SelectList(new[] { "Daily", "Weekly", "Monthly", "Quarterly", "Six Month", "Yearly" }), new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.ChecklistDate)
        @Html.TextBoxFor(m => m.ChecklistDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>
    <div class="form-group">
        <label for="itemLines">Checklist items (one per line)</label>
        <textarea name="itemLines" id="itemLines" class="form-control" rows="6"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
