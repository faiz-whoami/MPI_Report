@model MPI_Report.ViewModels.DashboardViewModel

@{
    ViewBag.Title = "Dashboard";
}

<h2>Dashboard</h2>
<p class="text-muted">
    Select a job, then open inventory, checklists, corrective actions, meetings, or MPI PDF reports.
</p>

@using (Html.BeginForm("SelectJob", "Home", FormMethod.Post, new { @class = "form-inline", style = "margin-bottom: 20px;" }))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="jobId">Client / Rig / Job</label>
        <select name="jobId" id="jobId" class="form-control" required>
            <option value="">-- Select job --</option>
            @foreach (var job in Model.Jobs)
            {
                var label = job.Customer != null
                    ? job.Customer.Name + " / " + (job.Rig != null ? job.Rig.Name : "") + " / " + job.JobNo
                    : job.JobNo;
                if (Model.SelectedJobId.HasValue && Model.SelectedJobId.Value == job.JobId)
                {
                    <option value="@job.JobId" selected="selected">@label</option>
                }
                else
                {
                    <option value="@job.JobId">@label</option>
                }
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Fetch data</button>
}

@if (!string.IsNullOrEmpty(Model.SelectedJobNo))
{
    <p><strong>Current job:</strong> @Model.SelectedJobNo</p>
}

<div class="row">
    <div class="col-md-2">
        <div class="panel panel-info">
            <div class="panel-heading">Inventory</div>
            <div class="panel-body"><h3>@Model.InventoryCount</h3></div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="panel panel-danger">
            <div class="panel-heading">Open CAs</div>
            <div class="panel-body"><h3>@Model.OpenCorrectiveActionCount</h3></div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="panel panel-success">
            <div class="panel-heading">Meetings</div>
            <div class="panel-body"><h3>@Model.DailyMeetingCount</h3></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="panel panel-warning">
            <div class="panel-heading">Checklists</div>
            <div class="panel-body"><h3>@Model.ChecklistCount</h3></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="panel panel-primary">
            <div class="panel-heading">MPI Reports</div>
            <div class="panel-body"><h3>@Model.MpiReportCount</h3></div>
        </div>
    </div>
</div>
