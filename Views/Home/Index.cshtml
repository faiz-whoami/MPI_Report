@{
    ViewBag.Title = "Dashboard";
}

<div ng-controller="homeController">

    <!-- DASHBOARD HEADER -->

    <div class="dashboard-heading">

        <div>

            <h1>Dashboard</h1>

        </div>

    </div>


    <!-- JOB SELECTOR -->

    <div class="dashboard-toolbar">

        <form ng-if="!isLoading && !loadError"
              ng-submit="selectJob()"
              class="job-selector-form">

            <div class="form-group">

                <label for="jobId">
                    Current Job
                </label>

                <select id="jobId"
                        class="form-control"
                        ng-model="selectedJobId"
                        required>

                    <option value="">
                        -- Select job --
                    </option>

                    <option ng-repeat="job in dashboard.Jobs"
                            value="{{job.JobId}}">

                        {{job.CustomerName + ' / ' + job.RigName + ' / ' + job.JobNo}}

                    </option>

                </select>

            </div>

            <button type="submit"
                    class="btn btn-primary dashboard-fetch-btn">

                <span class="glyphicon glyphicon-refresh"></span>

                Fetch Data

            </button>

        </form>

    </div>


    <!-- LOADING -->

    <div ng-if="isLoading"
         class="dashboard-loading">

        <span class="glyphicon glyphicon-refresh spinning"></span>

        Loading dashboard...

    </div>


    <!-- ERROR -->

    <div ng-if="loadError"
         class="alert alert-danger">

        {{ loadError }}

    </div>


    <!-- CURRENT JOB -->

    <div ng-if="dashboard.SelectedJobNo"
         class="current-job">

        <span class="glyphicon glyphicon-briefcase"></span>

        <div>

            <span class="current-job-label">
                Current Job
            </span>

            <strong>
                {{dashboard.SelectedJobNo}}
            </strong>

        </div>

    </div>


    <!-- STATISTICS -->

    <div ng-if="!isLoading && !loadError"
         class="dashboard-stat-grid">


        <!-- INVENTORY -->

        <div class="stat-card">

            <div class="stat-icon stat-icon-blue">

                <span class="glyphicon glyphicon-th-large"></span>

            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Inventory
                </span>

                <strong class="stat-value">
                    {{dashboard.InventoryCount}}
                </strong>

            </div>

        </div>


        <!-- CORRECTIVE ACTIONS -->

        <div class="stat-card">

            <div class="stat-icon stat-icon-red">

                <span class="glyphicon glyphicon-warning-sign"></span>

            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Open Corrective Actions
                </span>

                <strong class="stat-value">
                    {{dashboard.OpenCorrectiveActionCount}}
                </strong>

            </div>

        </div>


        <!-- MEETINGS -->

        <div class="stat-card">

            <div class="stat-icon stat-icon-green">

                <span class="glyphicon glyphicon-calendar"></span>

            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Daily Meetings
                </span>

                <strong class="stat-value">
                    {{dashboard.DailyMeetingCount}}
                </strong>

            </div>

        </div>


        <!-- CHECKLISTS -->

        <div class="stat-card">

            <div class="stat-icon stat-icon-orange">

                <span class="glyphicon glyphicon-check"></span>

            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Checklists
                </span>

                <strong class="stat-value">
                    {{dashboard.ChecklistCount}}
                </strong>

            </div>

        </div>


        <!-- MPI REPORTS -->

        <div class="stat-card">

            <div class="stat-icon stat-icon-purple">

                <span class="glyphicon glyphicon-file"></span>

            </div>

            <div class="stat-content">

                <span class="stat-label">
                    MPI Reports
                </span>

                <strong class="stat-value">
                    {{dashboard.MpiReportCount}}
                </strong>

            </div>

        </div>

    </div>

</div>