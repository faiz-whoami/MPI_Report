@model MPI_Report.ViewModels.DashboardViewModel

@{
    ViewBag.Title = "Dashboard";
    string newCookieToken;
    string formToken;
    AntiForgery.GetTokens(null, out newCookieToken, out formToken);
}

<script>
    window.dashboardData = @Html.Raw(Json.Encode(Model));
    window.dashboardData.SelectJobUrl = '@Url.Action("SelectJob", "Home")';
    window.dashboardData.IndexUrl = '@Url.Action("Index", "Home")';
    window.dashboardData.AntiForgeryToken = @Html.Raw(Json.Encode(formToken));
</script>

<div ng-controller="homeController">
    <h2>Dashboard</h2>
    <p class="text-muted">
        Select a job, then open inventory, checklists, corrective actions, meetings, or MPI PDF reports.
    </p>

    <form class="form-inline" ng-submit="selectJob()" style="margin-bottom: 20px;">
        <div class="form-group">
            <label for="jobId">Client / Rig / Job</label>
            <select id="jobId" class="form-control" ng-model="selectedJobId" required>
                <option value="">-- Select job --</option>
                <option ng-repeat="job in dashboard.Jobs" value="{{job.JobId}}">
                    {{job.CustomerName + ' / ' + job.RigName + ' / ' + job.JobNo}}
                </option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Fetch data</button>
    </form>

    <p ng-if="dashboard.SelectedJobNo"><strong>Current job:</strong> {{dashboard.SelectedJobNo}}</p>

    <div class="row">
        <div class="col-md-2">
            <div class="panel panel-info">
                <div class="panel-heading">Inventory</div>
                <div class="panel-body"><h3>{{dashboard.InventoryCount}}</h3></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="panel panel-danger">
                <div class="panel-heading">Open CAs</div>
                <div class="panel-body"><h3>{{dashboard.OpenCorrectiveActionCount}}</h3></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="panel panel-success">
                <div class="panel-heading">Meetings</div>
                <div class="panel-body"><h3>{{dashboard.DailyMeetingCount}}</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="panel panel-warning">
                <div class="panel-heading">Checklists</div>
                <div class="panel-body"><h3>{{dashboard.ChecklistCount}}</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="panel panel-primary">
                <div class="panel-heading">MPI Reports</div>
                <div class="panel-body"><h3>{{dashboard.MpiReportCount}}</h3></div>
            </div>
        </div>
    </div>
</div>
