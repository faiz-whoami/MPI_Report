@model IEnumerable<MPI_Report.Models.InspectionReport>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Inspection Reports";
}

<div class="row">
    <div class="col-md-12">

        <div class="page-header">
            <h2>Inspection Reports</h2>
            <p class="text-muted">
                Select an inspection report and generate its PDF.
            </p>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <strong>Generate MPI Report</strong>
            </div>

            <div class="panel-body">

                <div class="form-group">
                    <label for="reportSelect">
                        Select Inspection Report
                    </label>

                    <select id="reportSelect"
                            class="form-control">

                        <option value="">
                            -- Select a report --
                        </option>

                        @foreach (var report in Model)
                        {
                            <option value="@report.InspectionReportId">
                                @report.ReportNo
                                -
                                @report.WorkOrderNo
                            </option>
                        }

                    </select>
                </div>

                <div class="form-group">

                    <button type="button"
                            id="generateReportBtn"
                            class="btn btn-primary"
                            disabled>
                        Generate Report
                    </button>

                </div>

                <div id="reportMessage"
                     class="alert alert-info"
                     style="display:none;">
                </div>

            </div>
        </div>

        <div class="panel panel-default">

            <div class="panel-heading">
                <strong>Available Reports</strong>
            </div>

            <div class="panel-body">

                <p>
                    Total Reports:
                    <strong>@Model.Count()</strong>
                </p>

            </div>

        </div>

    </div>
    ```

</div>

@section scripts {
    <script>

    $(document).ready(function () {

        var reportSelect = $('#reportSelect');
        var generateButton = $('#generateReportBtn');

        /*
         * Enable Generate Report button
         * when a report is selected.
         */
        reportSelect.on('change', function () {

            var reportId = $(this).val();

            if (reportId) {

                generateButton.prop('disabled', false);

            }
            else {

                generateButton.prop('disabled', true);

            }

        });


        /*
         * Generate Report
         */
        generateButton.on('click', function () {

            var reportId = reportSelect.val();

            if (!reportId) {
                return;
            }

            /*
             * Navigate to:
             *
             * /Report/MPI/{id}
             *
             */
            window.location.href =
                '@Url.Action("MPI", "Report")/' + reportId;

        });

    });

    </script>
}
