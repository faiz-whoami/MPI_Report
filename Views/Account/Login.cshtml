@model MPI_Report.ViewModels.LoginViewModel

@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Sign In";
}

<div class="row" style="margin-top: 80px;" ng-controller="accountController">
    <div class="col-md-4 col-md-offset-4">
        <div class="panel panel-default">
            <div class="panel-heading">
                <strong>Inspections Track</strong>
            </div>
            <div class="panel-body">
                <p class="text-muted">Sign in to continue</p>

                @Html.AntiForgeryToken()

                <div class="alert alert-danger" ng-if="errorMessage">
                    {{ errorMessage }}
                </div>

                <form name="loginForm" ng-submit="login()" novalidate>
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input id="username"
                               name="username"
                               type="text"
                               class="form-control"
                               autocomplete="username"
                               ng-model="model.username"
                               required />
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input id="password"
                               name="password"
                               type="password"
                               class="form-control"
                               autocomplete="current-password"
                               ng-model="model.password"
                               required />
                    </div>

                    <button type="submit"
                            class="btn btn-primary btn-block"
                            ng-disabled="loginForm.$invalid || isSubmitting">
                        <span ng-if="!isSubmitting">Login</span>
                        <span ng-if="isSubmitting">Signing in...</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
