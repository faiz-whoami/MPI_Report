@model IEnumerable<MPI_Report.Models.InventoryItem>

@{
    ViewBag.Title = "Item Inventory";
}

<h2>Item Inventory</h2>
<p>@Html.ActionLink("Add item", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Description</th>
            <th>Position</th>
            <th>Type</th>
            <th>Status</th>
            <th>Special type</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ItemCode</td>
                <td>@item.Description</td>
                <td>@item.Position</td>
                <td>@item.ItemType</td>
                <td>@item.Status</td>
                <td>@item.SpecialType</td>
            </tr>
        }
    </tbody>
</table>
